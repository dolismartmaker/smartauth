#!/usr/bin/make
# makefile for cap-rel projects
#

SHELL = bash
MODULE = smartauth
DOC_HOST     ?= doc.cap-rel.fr
DOC_PATH     ?= /home/webs/doc.cap-rel.fr/marginaliamd/data/documents/$(MODULE)
MARGINALIAMD ?= $(HOME)/dev/marginaliamd

.DEFAULT_GOAL := help
.PHONY: help zip check-zip deploy-doc screenshots phpstan

# Passed explicitly to the recursive call below, so that "make -f Makefile.dist zip"
# keeps using this file instead of falling back to the Makefile wrapper.
THIS_MAKEFILE := $(firstword $(MAKEFILE_LIST))

# The zip and the ChangeLog copy both land here. Overriding TMPDIR is how two
# accounts package on the same machine without fighting over /tmp/module_*.zip,
# which is owned by whoever built first.
RELEASE_DIR ?= $(if $(TMPDIR),$(TMPDIR),/tmp)

help:
	@echo ''
	@echo 'Usage: make <target>'
	@echo ''
	@echo '  zip            -  create distributable zip archive'
	@echo '  check-zip      -  fail if the built zip carries a development dependency'
	@echo '  deploy-doc     -  publish user documentation to doc.cap-rel.fr'
	@echo '  screenshots    -  collect missing screenshots interactively'
	@echo '  phpstan        -  run static analysis with PHPStan'
	@echo ''

# vendor/ is wiped then reinstalled --no-dev, because composer only removes what
# it believes it installed: against a stale installed.json it reports "0 removals"
# and ships the whole test harness. check_nodev.php verifies the outcome instead
# of trusting the command, on the tree before the build and on the archive after.
# The build runs inside a single shell recipe so that the development
# dependencies are reinstalled even when it fails: leaving vendor/ amputated
# silently breaks phpunit and the Dolibarr harness until the next manual install.
zip: clean
	@echo '==> installing production dependencies'
	composer install --no-dev --optimize-autoloader --no-interaction
	@set +e; \
		php build/check_nodev.php vendor && php ./build/buildzip.php; \
		status=$$?; \
		echo '==> restoring development dependencies'; \
		composer install --no-interaction \
			|| echo 'ERROR: development dependencies were NOT restored, run "composer install" by hand'; \
		exit $$status
	$(MAKE) --no-print-directory -f $(THIS_MAKEFILE) check-zip
	cp -f ChangeLog.md $(RELEASE_DIR)/

check-zip:
	php build/check_nodev.php zip

deploy-doc:
	rsync -avLP docs/users/ $(DOC_HOST):$(DOC_PATH)/

screenshots:
	php $(MARGINALIAMD)/cli/collect-screenshots.php docs/users/

phpstan:
	TMPDIR=$(HOME)/.cache/phpstan-tmp DOLIBARR_VERSION=18 php /usr/local/bin/phpstan.phar analyse -c .phpstan.local.neon --memory-limit=512M

apidoc:
	# apidoc -i api/ -o ./documentation -c api/apidoc.json -f ".*.php"
	apidoc-markdown -i api/ -o ./documentation/doc.md -c api/apidoc.json -f ".*.php"
	# rsync -avP /documentation/ z.cap-rel.fr://home/webs/z.cap-rel.fr/htdocs/doc/

composerdump:
	php7.4 /usr/local/bin/composer.phar dump-autoload --optimize --classmap-authoritative --ansi

stubs: api/*.php dolMapping/*.php
	~/.config/composer/vendor/bin/generate-stubs \
		api/*.php \
		--include-inaccessible-class-nodes \
		--force \
		--header="/** Generated stub declarations for SmartAuth. - @see https://cap-rel.fr */" \
		--functions \
		--classes \
		--interfaces \
		--traits \
		--constants \
		--documented-globals \
		--out="stubs/smartauth-stubs.php"
	~/.config/composer/vendor/bin/generate-stubs \
		dolMapping/*.php \
		--include-inaccessible-class-nodes \
		--force \
		--header="/** Generated stub declarations for SmartAuth. - @see https://cap-rel.fr */" \
		--functions \
		--classes \
		--interfaces \
		--traits \
		--constants \
		--documented-globals \
		--out="stubs/dolmapping-stubs.php"
	if [ ! -d /home/erics/dev/caprel-stubs/${MODULE} ]; then mkdir /home/erics/dev/caprel-stubs/${MODULE}; fi
	cp -a stubs/* /home/erics/dev/caprel-stubs/${MODULE}
	echo "stubs copied to /home/erics/dev/caprel-stubs/ please commit that repo !"

cleandevsqlite:
	if [ -d vendor/cap-rel/dolibarr-integration-sqlite/ ]; then cd vendor/cap-rel/dolibarr-integration-sqlite/ && git reset --hard; fi

tests:
	php -d display_startup_errors=0 -d display_errors=0 -d pcov.enabled=1 -d pcov.directory="./" vendor/bin/phpunit -c phpunit-integration-dolibarr.xml --coverage-text --coverage-cobertura=.phpunit.cache/coverage.xml 2>&1 | tee .phpunit.cache/coverage-output.txt

clean:
	rm -rf vendor

